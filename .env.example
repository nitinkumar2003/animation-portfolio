# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# Canonical origin of the deployed site, with no trailing slash.
# Everything SEO depends on this: canonical tags, Open Graph URLs,
# sitemap.xml entries, robots.txt and every JSON-LD @id.
# Leaving it unset makes the live site advertise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Ask Nitin assistant — powered by xAI Grok
# Server-only. Never prefix this key with NEXT_PUBLIC_.
# Get a key at https://console.x.ai . GROK_API_KEY works as an alias.
# Without it the assistant renders but returns a "not configured" message.
XAI_API_KEY=

# Optional. Defaults to grok-4-fast.
# Check https://docs.x.ai/docs/models for the current model ids before changing.
XAI_MODEL=grok-4-fast
